// PianoHand detail displacement - volume preservation + joint creases (Phase 3, tensor revision)
//
// Runs after CustomSkinningDeformer.usf (skinning) and CustomSkinningTension.usf (per-vertex strain
// tensor), inside the same RDG graph. Everything here is derived from data the GPU already has - the
// skin weight stream, the rest pose and the per-vertex strain tensor - so no painted tension /
// wrinkle / vein maps are needed and the effect works on any skeletal mesh.
//
//  DisplaceCS         : one thread per section vertex. Moves the skinned position along its normal by
//                         d = d_volume + d_crease + d_wrinkle
//                       and writes it back into the passthrough vertex factory position buffer. It
//                       also rewrites the vertex colour with the BONE-RELATIVE strain, because it is
//                       the one pass that knows which way the bone runs.
//  NormalAccumulateCS : one thread per triangle. Atomically accumulates face normals of the *displaced*
//                       surface onto its 3 vertices (fixed point), so the new folds actually shade.
//  NormalResolveCS    : one thread per LOD vertex. Normalises that sum, re-orthogonalises the stored
//                       tangent against it, and writes both back to the tangent buffer.
//
// ---------------------------------------------------------------------------------------------
// The strain tensor (CustomSkinningTension.usf) gives, per vertex, the averaged right Cauchy-Green
// tensor C3 in rest component space. Projected onto the rest tangent plane it is a 2x2 whose
// eigenvalues are the squared principal stretches and whose determinant is the squared AREA ratio J.
// Projected onto the bone axis it gives the stretch ALONG the finger - which is what a bending joint
// changes - and onto the perpendicular the stretch ACROSS it.
//
// d_volume  - volume preservation
//     An incompressible solid whose surface area is scaled by J has to change thickness by 1/J, so
//     compression (J < 1) pushes the surface out and stretch pulls it in. This is what makes a bent
//     knuckle bulge instead of collapsing the way raw LBS does. (Before the tensor this used the
//     isotropic guess 1/lambda^2 from a scalar edge strain.)
//
// d_crease  - the permanent joint creases
//     A vertex sitting on a joint is, by construction, a vertex the skinning blends between two bones.
//     Taking the two largest influence weights w0 >= w1, the quantity 4*w0*w1 is 0 on rigid parts and
//     exactly 1 on the 50/50 blend line that runs along the joint - a joint band that costs nothing to
//     compute and needs no authored mask. Grooving along that band gives the creases that are visible
//     on every knuckle even with the finger held straight; the groove deepens with compression ALONG
//     the bone and is ironed flat by stretch.
//
// d_wrinkle - the extra folds that appear when bending, and again on the way back
//     Ripples along the bone's own axis inside the joint band. Folds form perpendicular to the
//     compression axis (Rohmer et al. 2010), and on a finger that axis is the bone, so the ripples
//     are driven by the along-bone compression only - sideways squash does not make knuckle folds.
//
// Vertex colour written here (overrides the principal-strain colour from ResolveCS):
//     R = stretch (lambda_max - 1)          G = compression ALONG the bone (1 - lambda_bone)
//     B = compression ACROSS the bone        A = relax slack (from ResolveCS, passed through)
// ---------------------------------------------------------------------------------------------

#include "/Engine/Private/Common.ush"
#include "/Engine/Private/GpuSkinCommon.ush"
#include "/PianoHand/Public/SkinningCommon.ush"

#ifndef THREADGROUP_SIZE
#define THREADGROUP_SIZE 64
#endif

// Fixed point scale for the atomic normal accumulation. Contributions are unit vectors, so a vertex
// would need > 500k incident triangles to overflow int32.
#define NORMAL_FIXED_SCALE 4096.0f

// ---------------------------------------------------------------------------
// Displace (per section vertex)
// ---------------------------------------------------------------------------

uint  NumVertices;           // vertices in this section
uint  BaseVertexIndex;       // first vertex of this section inside the LOD buffers
uint  NumBoneInfluences;     // max influences per vertex (constant-stride weight layout)
uint  InputWeightStride;     // bytes per vertex in the weight stream
uint  NumSectionBones;       // entries in RefPoseInverses (section BoneMap order)

float VolumeBulge;           // cm of outward motion at ~lambda 0.8; 0 disables volume preservation
float CreaseDepth;           // cm, groove depth on the joint band at rest
float CreaseSharpness;       // exponent narrowing the joint band (1 = wide, 8 = tight)
float CreaseCompressionGain; // how much extra depth compression adds
float WrinkleAmplitude;      // cm, bending-only ripples inside the joint band
float WrinkleFrequency;      // radians per cm along the bone axis
float CreaseStretchRelief;   // how strongly stretch irons the resting groove flat
float RelaxCreaseGain;       // cm of extra groove at full relax slack
float TensionScale;          // strain -> 0..1 colour mapping, same value ResolveCS uses

// ---- Phase 5: mask-driven groove on the PRIMARY crease line only ------------------------------
// The band-wide trench above reads as a cuff, because the skin-weight band is as wide as the
// whole joint. The baked wrinkle mask (T_PH_WrinkleMask, see Tools/bake_skin_maps.py) knows the
// crease LINE: G is the unsigned distance along the bone to the band centre, so a Bando furrow
// in that coordinate is a groove a millimetre wide sitting exactly under the material's primary
// crease. Gated like the material (palm deepens with compression, knuckle irons out with stretch)
// so geometry and shading agree. Only the primary line is grooved - the fine folds stay a
// normal-map job, where 0.3 mm of real displacement would read as lumps.
uint  bHasWrinkleMask;
uint  NumUVChannels;
float MaskCreaseDepth;       // cm, groove depth at full gate
float MaskCreaseWidth;       // cm, Bando w
float MaskCreaseRange;       // cm, S_RANGE of the bake (mask G * this = distance to the band centre)
float MaskGain;
float MaskSharpness;
float MaskPalmSplit;         // cm, half-distance of the palmar PIP double crease
// one declaration per line: UE's shader parameter parser does not split comma lists
float MaskPalmarBase;
float MaskPalmarCompress;
float MaskPalmarIron;
float MaskDorsalBase;
float MaskDorsalIron;
// Phase 9: gathered skin over an extended knuckle (ridges parallel to the crease, ironed by flexion)
float DorsalGather;          // cm, ridge height
float DorsalGatherSpacing;   // cm between ridges
float DorsalGatherReach;     // cm from the crease where the ridges die out
float DorsalGatherBase;      // standing gate on an extended knuckle
float DorsalGatherIron;      // how fast flexion stretch spends it
float PalmarPadHeight;       // cm, how far the skin on either side of a palmar crease bulges out at full fold
float PalmarPadDist;         // cm from the crease where the bulge peaks
float PalmarPadWidth;        // cm, half-width of the bulge
float PalmarFold2Depth;      // cm, depth of the secondary fold at full fold
float PalmarFold2Dist;       // cm from the crease to the secondary fold
float PalmarFold2Width;      // cm, half-width of the secondary fold
float PalmarCreaseDeepen;    // cm, extra depth of the primary crease at full fold
float PalmarFoldBendFull;    // radians of real joint bend at which the fold is complete
Texture2D      WrinkleMask;
SamplerState   WrinkleMaskSampler;
Buffer<float2> UVInputBuffer;        // engine texcoord stream, NumUVChannels per vertex

// ---- Phase 7: joint contact + volume-preserving bulge ------------------------------------------
// Skinning, however good, only interpolates. The inside of a bent finger does something it cannot:
// the two segments meet, and the tissue caught between them has nowhere to go but out - it rolls
// up around the fold. Vaillant et al. 2013 ("Implicit Skinning") get this by giving each bone an
// implicit field and composing neighbours with a gradient-based bulge-in-contact operator whose
// strength follows the bend angle (union at rest, full bulge from 90 degrees); Brunel, Benard and
// Guennebaud 2021 ("A Time-Independent Deformer for Elastic Contacts") spread a volume-preserving
// profile over a deformable region around the contact zone. Here each bone is a capsule (origin,
// axis end, radius measured from the rest mesh); for a vertex on segment b with the joint partner
// o, f_o = r_o - dist(x, axis_o) is the partner's field. Inside the fold:
//   contact  f_o + margin > 0 : the vertex is pushed out of the partner along grad f_o, onto the
//            contact surface (the margin is the skin thickness that never flattens)
//   bulge    around the contact zone, u = -(f_o + margin) / reach runs 0..1 outward; a bump profile
//            in u, peaking at BulgeSpread, lifts the ring along the normal
// Both are scaled by theta(alpha) = smoothstep(BendStart, BendFull, bend angle) and confined to the
// fold side (the half-space the two bone axes bend into). The outside of the joint is pulled onto
// the bone a little instead (DorsalTighten): skin goes taut over a knuckle.
uint  bContactBulge;
float ContactMargin;         // cm
float BulgeGain;             // cm, ring height at a full bend
float BulgeReach;            // cm, deformable region width
float BulgeSpread;           // 0..1, where the ring peaks
float BendStart;             // radians
float BendFull;              // radians
float CapsuleRadiusScale;
float DorsalTighten;         // cm
StructuredBuffer<FBoneTransform> BoneTransforms;   // animated, section order
StructuredBuffer<float4>         BoneCapsules;     // 2 per section bone: (rest origin, radius), (rest end, parent section index)

Buffer<float>                    RestPositionBuffer;   // 3 floats per vertex, rest pose
Buffer<SNORM float4>             RestTangentBuffer;    // 2 per vertex: TangentX, TangentZ (w = sign), rest pose
uint                             bUseProportionedRest; // Phase 5: read the proportion-scaled rest instead (see CustomSkinningTension.usf)
Buffer<float>                    ProportionedRestPositionBuffer;
Buffer<SNORM float4>             ProportionedRestTangentBuffer;
Buffer<uint>                     InputWeightStream;    // FSkinWeightVertexBuffer data
StructuredBuffer<FBoneTransform> RefPoseInverses;      // RefBasesInvMatrix in section BoneMap order
StructuredBuffer<float>          VertexTensor;         // averaged C3, 6 floats per LOD vertex (xx yy zz xy xz yz)
StructuredBuffer<float2>         RelaxStateIn;         // .y = relax slack, from CustomSkinningTension.usf
StructuredBuffer<uint>           WeldCanon;            // 10-18: canonical vertex of a UV-seam twin - its normal, tangent and UV are used so both copies displace alike

RWBuffer<float>                   PositionBufferUAV;   // read + write (displaced in place)
RWBuffer<TANGENT_RWBUFFER_FORMAT> TangentBufferUAV;    // read only in this pass
RWBuffer<UNORM float4>            ColorBufferUAV;      // vertex colour, rewritten with bone-relative strain

#define TENSOR_STRIDE 6u

// v^T C3 w for a symmetric 3x3 stored as (xx, yy, zz, xy, xz, yz)
float TensorForm(float C[6], float3 V, float3 W)
{
	return C[0] * V.x * W.x + C[1] * V.y * W.y + C[2] * V.z * W.z
	     + C[3] * (V.x * W.y + V.y * W.x)
	     + C[4] * (V.x * W.z + V.z * W.x)
	     + C[5] * (V.y * W.z + V.z * W.y);
}

float3 LoadPosition(Buffer<float> Buf, uint VertexIndex)
{
	return float3(Buf[VertexIndex * 3 + 0], Buf[VertexIndex * 3 + 1], Buf[VertexIndex * 3 + 2]);
}

// Bando, Kuratate, Nishita 2002 furrow section: -1 at the bottom, a low bank at 2w, 0 beyond.
// Same profile as PianoHandSkin.ush's PH_Furrow so the groove and the shading line up.
float MaskFurrow(float L, float W)
{
	const float X = abs(L) / max(W, 1e-4f);
	const float S = (X - 1.0f) * exp(-X);
	return (S > 0.0f) ? S * 0.4f : S;
}

float3 ClosestOnSegment(float3 P, float3 A, float3 B, out float T)
{
	const float3 AB = B - A;
	T = saturate(dot(P - A, AB) / max(dot(AB, AB), 1e-6f));
	return A + AB * T;
}

// Contact push (along the partner's field gradient) and normal-direction bulge for the joint between
// the dominant bone and its second influence. Returns false when the two bones do not form a joint.
bool ContactBulge(float3 X, float3 XRest, uint Bone, uint Other, out float3 OutPush, out float OutBulge)
{
	OutPush = float3(0, 0, 0);
	OutBulge = 0.0f;
	if (Bone == Other || Bone >= NumSectionBones || Other >= NumSectionBones)
	{
		return false;
	}
	const float4 Cb0 = BoneCapsules[Bone * 2u], Cb1 = BoneCapsules[Bone * 2u + 1u];
	const float4 Co0 = BoneCapsules[Other * 2u], Co1 = BoneCapsules[Other * 2u + 1u];
	const int ParentB = (int)Cb1.w;
	const int ParentO = (int)Co1.w;
	// which of the two is the parent segment of this joint
	uint P, C;
	if (ParentB == (int)Other) { P = Other; C = Bone; }
	else if (ParentO == (int)Bone) { P = Bone; C = Other; }
	else { return false; }
	const float4 Cp0 = BoneCapsules[P * 2u], Cp1 = BoneCapsules[P * 2u + 1u];
	const float4 Cc0 = BoneCapsules[C * 2u], Cc1 = BoneCapsules[C * 2u + 1u];
	if (Cp0.w <= 0.0f || Cc0.w <= 0.0f)
	{
		return false;   // unmeasured capsule
	}
	const FBoneTransform Mp = BoneTransforms[P];
	const FBoneTransform Mc = BoneTransforms[C];
	const float3 Op = TransformPosition(Mp, Cp0.xyz), Ep = TransformPosition(Mp, Cp1.xyz);
	const float3 Oc = TransformPosition(Mc, Cc0.xyz), Ec = TransformPosition(Mc, Cc1.xyz);
	const float3 Ap = normalize(Ep - Op + 1e-5f);        // parent axis, pointing to the joint
	const float3 Ac = normalize(Ec - Oc + 1e-5f);        // child axis, pointing away from it
	const float Bend = acos(clamp(dot(Ap, Ac), -1.0f, 1.0f));
	const float Theta = smoothstep(BendStart, BendFull, Bend);
	if (Theta <= 0.0f)
	{
		return false;
	}
	// The fold's interior is the side the axes bend into. Measured RADIALLY: the vector from the
	// vertex's own axis to the vertex, against the bend direction with the axis component removed.
	// (Measured from the joint origin instead, anything distal of the joint counted as "inside" -
	// the back of every knuckle bulged.)
	const bool bOnParent = (Bone == P);
	const float3 Aown = bOnParent ? Ap : Ac;
	const float3 Oown = bOnParent ? Op : Oc, Eown = bOnParent ? Ep : Ec;
	float Town;
	const float3 Qown = ClosestOnSegment(X, Oown, Eown, Town);
	const float3 Radial = normalize(X - Qown + 1e-5f);
	float3 Inside = -Ap + Ac;
	Inside = Inside - Aown * dot(Inside, Aown);
	Inside = normalize(Inside + 1e-5f);
	const float Side = dot(Radial, Inside);
	const float InFold = smoothstep(0.1f, 0.6f, Side);
	const float Outside = smoothstep(0.1f, 0.6f, -Side);
	// the squeezed tissue goes SIDEWAYS as much as inward (Brunel's anisotropic spread): the bulge
	// ring covers the palmar half and the two flanks, and only the back of the joint is excluded
	const float BulgeSide = smoothstep(-0.35f, 0.45f, Side);

	// the partner's capsule field at X
	const bool bPartnerIsParent = (Other == P);
	const float3 Oo = bPartnerIsParent ? Op : Oc, Eo = bPartnerIsParent ? Ep : Ec;
	const float Ro = (bPartnerIsParent ? Cp0.w : Cc0.w);
	float T;
	const float3 Q = ClosestOnSegment(X, Oo, Eo, T);
	const float3 Away = X - Q;
	const float D = length(Away);
	const float3 Grad = Away / max(D, 1e-4f);
	const float F = Ro - D;                               // > 0 inside the partner
	// The two capsules of a joint overlap at REST (the skin over a joint is bound to both bones), so
	// the raw field says "inside the partner" for a ring of skin that is perfectly fine. Only the
	// penetration the BEND adds counts: the rest-pose field value, measured on the rest capsule, is
	// the baseline. (Vaillant et al. keep each vertex's own rest iso-value for the same reason.)
	const float3 OoR = bPartnerIsParent ? Cp0.xyz : Cc0.xyz, EoR = bPartnerIsParent ? Cp1.xyz : Cc1.xyz;
	float TR;
	const float3 QR = ClosestOnSegment(XRest, OoR, EoR, TR);
	const float FRest = Ro - length(XRest - QR);
	const float Pen = (F - max(FRest, 0.0f)) + ContactMargin * Theta;

	// contact: out of the partner, onto its margin surface
	const float Push = max(Pen, 0.0f) * Theta * InFold;
	OutPush = Grad * Push;
	// bulge: a bump over the deformable ring outside the contact zone, volume rolled up from it
	const float U = saturate(-Pen / max(BulgeReach, 1e-3f));
	const float Spread = clamp(BulgeSpread, 0.05f, 0.95f);
	const float Profile = (U < Spread) ? smoothstep(0.0f, Spread, U) : 1.0f - smoothstep(Spread, 1.0f, U);
	OutBulge = BulgeGain * Profile * Theta * BulgeSide - DorsalTighten * Theta * Outside;
	return true;
}

// Groove depth (cm, negative = inward) on the primary crease line at this vertex.
float MaskCreaseDisplacement(uint VertexIndex, float CompressionC, float StretchC)
{
	const float2 UV = UVInputBuffer[VertexIndex * max(NumUVChannels, 1u)];
	const float4 M = WrinkleMask.SampleLevel(WrinkleMaskSampler, UV, 0);
	const float Band = pow(saturate(M.r * MaskGain), max(MaskSharpness, 0.1f));
	if (Band < 1e-4f)
	{
		return 0.0f;
	}
	const float S0 = M.g * MaskCreaseRange;                 // cm to the band centre, unsigned
	const float Dorsal = saturate((M.a * 2.0f - 1.0f) * 1.5f + 0.5f);   // SideSharpness 3, as the material
	const int JT = (int)round(saturate(M.b) * 5.0f);
	// the palmar PIP crease is a pair, +-Split; everywhere else a single line on the band centre
	const float Split = (JT == 2) ? MaskPalmSplit * (1.0f - Dorsal) : 0.0f;
	const float Furrow = MaskFurrow(S0 - Split, MaskCreaseWidth);
	const float GatePalm = saturate(MaskPalmarBase + CompressionC * MaskPalmarCompress - StretchC * MaskPalmarIron);
	const float GateBack = saturate(MaskDorsalBase - StretchC * MaskDorsalIron);
	return MaskCreaseDepth * Furrow * Band * lerp(GatePalm, GateBack, Dorsal);
}

// 10-18: the skin on the INSIDE of a bending joint does not just crease - the length it loses along
// the bone has to go somewhere, so it piles up: the primary crease deepens, the skin on either side of
// it bulges out into pads, and a secondary fold forms a little further out. A buckled sheet keeps its
// length, so the amplitudes grow like sqrt(compression). Driven by the larger of the measured along-bone
// compression and the real bend of the joint (rigid-tube skinning understates the strain at a knuckle).
float PalmarFoldDisplacement(uint VertexIndex, float CompressC, uint Bone, uint Other)
{
	if (PalmarPadHeight <= 0.0f && PalmarFold2Depth <= 0.0f && PalmarCreaseDeepen <= 0.0f)
	{
		return 0.0f;
	}
	float BendDrive = 0.0f;
	if (Bone != Other && Bone < NumSectionBones && Other < NumSectionBones)
	{
		const FBoneTransform Rb = RefPoseInverses[Bone], Ro = RefPoseInverses[Other];
		const float3 AxisB = normalize(float3(Rb.Row0.x, Rb.Row1.x, Rb.Row2.x));
		const float3 AxisO = normalize(float3(Ro.Row0.x, Ro.Row1.x, Ro.Row2.x));
		const float3 AnimB = normalize(TransformVector(BoneTransforms[Bone], AxisB) + 1e-6f);
		const float3 AnimO = normalize(TransformVector(BoneTransforms[Other], AxisO) + 1e-6f);
		const float Bend = abs(acos(clamp(dot(AnimB, AnimO), -1.0f, 1.0f)) - acos(clamp(dot(AxisB, AxisO), -1.0f, 1.0f)));
		BendDrive = saturate(Bend / max(PalmarFoldBendFull, 0.05f));
	}
	const float Drive = max(CompressC, BendDrive);
	if (Drive < 1e-3f)
	{
		return 0.0f;
	}
	const float2 UV = UVInputBuffer[VertexIndex * max(NumUVChannels, 1u)];
	const float4 M = WrinkleMask.SampleLevel(WrinkleMaskSampler, UV, 0);
	const float Band = saturate(M.r * MaskGain * 1.6f);                            // the band reads ~0.6 where the pads sit: full there, fading past the fold region
	const float Palmar = 1.0f - saturate((M.a * 2.0f - 1.0f) * 1.5f + 0.5f);
	if (Band * Palmar < 1e-3f)
	{
		return 0.0f;
	}
	const float S0 = M.g * MaskCreaseRange;                                        // cm to the crease, unsigned
	const int JT = (int)round(saturate(M.b) * 5.0f);
	const float Split = (JT == 2) ? MaskPalmSplit : 0.0f;                          // the palmar PIP crease is a pair
	const float Amp = sqrt(Drive);
	// pads either side of the crease, measured from the outer crease of the pair
	const float Sp = max(S0 - Split, 0.0f);
	const float Pad = exp(-(Sp - PalmarPadDist) * (Sp - PalmarPadDist) / max(PalmarPadWidth * PalmarPadWidth, 1e-4f));
	const float Fold2 = exp(-(Sp - PalmarFold2Dist) * (Sp - PalmarFold2Dist) / max(PalmarFold2Width * PalmarFold2Width, 1e-4f));
	const float Furrow = MaskFurrow(S0 - Split, MaskCreaseWidth * 1.3f);           // < 0 in the crease
	const float Var = 0.85f + 0.15f * sin(UV.x * 611.0f + UV.y * 283.0f);
	return Band * Palmar * Amp * (PalmarPadHeight * Pad * Var - PalmarFold2Depth * Fold2 + PalmarCreaseDeepen * Furrow);
}

// Ridges of gathered skin on the BACK of an extended joint, parallel to the crease on both sides of
// it (cm, positive = outward). The skin over a knuckle is slack when the finger is straight - it has
// to be, to cover the knuckle when it bends - and stands in a few parallel folds; flexion pulls it
// taut. The crease itself (S0 = 0) stays a valley: the ridges peak half a spacing away.
float DorsalGatherDisplacement(uint VertexIndex, float StretchC, uint Bone, uint Other)
{
	if (DorsalGather <= 0.0f)
	{
		return 0.0f;
	}
	// the actual bend of the joint between the two influences: the skin over a knuckle is slack when
	// the finger is straight and taut from about 40 degrees on, whatever the local strain says
	float BendGate = 1.0f;
	if (Bone != Other && Bone < NumSectionBones && Other < NumSectionBones)
	{
		const FBoneTransform Rb = RefPoseInverses[Bone], Ro = RefPoseInverses[Other];
		const float3 AxisB = normalize(float3(Rb.Row0.x, Rb.Row1.x, Rb.Row2.x));
		const float3 AxisO = normalize(float3(Ro.Row0.x, Ro.Row1.x, Ro.Row2.x));
		const float3 AnimB = normalize(TransformVector(BoneTransforms[Bone], AxisB) + 1e-6f);
		const float3 AnimO = normalize(TransformVector(BoneTransforms[Other], AxisO) + 1e-6f);
		const float Bend = abs(acos(clamp(dot(AnimB, AnimO), -1.0f, 1.0f)) - acos(clamp(dot(AxisB, AxisO), -1.0f, 1.0f)));
		BendGate = 1.0f - smoothstep(0.15f, 0.7f, Bend);
	}
	const float2 UV = UVInputBuffer[VertexIndex * max(NumUVChannels, 1u)];
	const float4 M = WrinkleMask.SampleLevel(WrinkleMaskSampler, UV, 0);
	const float Band = pow(saturate(M.r * MaskGain), max(MaskSharpness, 0.1f));
	const float Dorsal = saturate((M.a * 2.0f - 1.0f) * 1.5f + 0.5f);
	if (Band * Dorsal < 1e-3f)
	{
		return 0.0f;
	}
	const float S0 = M.g * MaskCreaseRange;                  // cm to the crease, unsigned
	const float Gate = saturate(DorsalGatherBase - StretchC * DorsalGatherIron) * BendGate;
	// 10-18: gathered skin is rounded PADS separated by narrow fold valleys, not a sine corrugation, and the folds run
	// continuously across the finger with only a slow change of height - the old per-texel noise made the ridges
	// read as cobbles and scalloped the silhouette. The folds also die out towards the flanks of the finger.
	const float Wobble = 0.025f * sin(UV.y * 160.0f + UV.x * 70.0f);                  // cm, a gentle waver of the fold lines
	const float Phase = 0.5f - 0.5f * cos(6.2831853f * (S0 + Wobble) / DorsalGatherSpacing);   // 0 on the crease, 1 half a spacing out
	const float Ridge = pow(Phase, 0.45f);                                               // wide pads, narrow valleys
	const float Env = exp(-(S0 * S0) / (DorsalGatherReach * DorsalGatherReach));
	const float Var = 0.85f + 0.15f * sin(UV.x * 110.0f + UV.y * 65.0f);                  // slow height change along the fold
	const float Flank = smoothstep(0.3f, 0.85f, Dorsal);                                 // gone on the sides of the finger
	return DorsalGather * Band * Flank * Gate * Ridge * Env * Var;
}

[numthreads(THREADGROUP_SIZE, 1, 1)]
void DisplaceCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint LocalIndex = DispatchThreadId.x;
	if (LocalIndex >= NumVertices)
	{
		return;
	}
	const uint VertexIndex = BaseVertexIndex + LocalIndex;
	const uint Vc = WeldCanon[VertexIndex];   // seam twin -> canonical vertex for every per-vertex INPUT; writes stay at VertexIndex

	const float3 SkinnedP = float3(
		PositionBufferUAV[VertexIndex * 3 + 0],
		PositionBufferUAV[VertexIndex * 3 + 1],
		PositionBufferUAV[VertexIndex * 3 + 2]);

	const float4 PackedTZ = TangentBias_SkinCache(TangentBufferUAV[Vc * 2 + GPUSKIN_RWBUFFER_OFFSET_TANGENT_Z]);
	const float3 Normal = normalize(PackedTZ.xyz + float3(0.0f, 0.0f, 1e-6f));

	// ---- strain tensor in the rest tangent plane ------------------------------
	float C[6];
	UNROLL
	for (uint c = 0; c < TENSOR_STRIDE; ++c)
	{
		C[c] = VertexTensor[VertexIndex * TENSOR_STRIDE + c];
	}
	const float4 RestTX = (bUseProportionedRest != 0u) ? ProportionedRestTangentBuffer[Vc * 2 + GPUSKIN_VB_OFFSET_TANGENT_X] : RestTangentBuffer[Vc * 2 + GPUSKIN_VB_OFFSET_TANGENT_X];
	const float4 RestTZ = (bUseProportionedRest != 0u) ? ProportionedRestTangentBuffer[Vc * 2 + GPUSKIN_VB_OFFSET_TANGENT_Z] : RestTangentBuffer[Vc * 2 + GPUSKIN_VB_OFFSET_TANGENT_Z];
	const float3 RestN = normalize(RestTZ.xyz + float3(0, 0, 1e-6f));
	float3 RestT = RestTX.xyz - RestN * dot(RestN, RestTX.xyz);
	RestT = (dot(RestT, RestT) > 1e-8f) ? normalize(RestT) : float3(1, 0, 0);
	const float3 RestB = cross(RestN, RestT) * (RestTZ.w < 0.0f ? -1.0f : 1.0f);

	const float a = TensorForm(C, RestT, RestT);
	const float b = TensorForm(C, RestT, RestB);
	const float d = TensorForm(C, RestB, RestB);
	const float Half = 0.5f * (a + d);
	const float Disc = sqrt(max(0.25f * (a - d) * (a - d) + b * b, 0.0f));
	const float LambdaMax = sqrt(max(Half + Disc, 0.0f));
	const float AreaRatio = sqrt(max(a * d - b * b, 1e-4f));       // J = lambda_1 * lambda_2

	// ---- volume preservation ------------------------------------------------
	// thickness factor of an incompressible slab whose area scaled by J is 1/J
	// An incompressible slab: thickness scales by 1/J. Clamped to what skin actually does - about
	// +70% thicker where it is gathered hard (a fist's palmar fold) and -40% where pulled taut -
	// because past that the strain field is reporting folded-over triangles, not tissue.
	const float VolumeTerm = VolumeBulge * clamp(1.0f / AreaRatio - 1.0f, -0.4f, 0.7f);

	// ---- joint band from the skin weights -----------------------------------
	const uint StreamOffset = VertexIndex * (InputWeightStride / 4);
	const uint NumGroups = (NumBoneInfluences + 3) / 4;

	float LargestWeight = 0.0f;
	float SecondWeight = 0.0f;
	uint  DominantBone = 0;
	uint  SecondBone = 0;

	for (uint g = 0; g < NumGroups; ++g)
	{
		const int4   Idx = GetBlendIndices(InputWeightStream, StreamOffset, g);
		const float4 W   = GetBlendWeights(InputWeightStream, StreamOffset, g, NumBoneInfluences);
		UNROLL
		for (uint i = 0; i < 4; ++i)
		{
			const float Weight = W[i];
			if (Weight > LargestWeight)
			{
				SecondWeight = LargestWeight;
				SecondBone = DominantBone;
				LargestWeight = Weight;
				DominantBone = (uint)Idx[i];
			}
			else if (Weight > SecondWeight)
			{
				SecondWeight = Weight;
				SecondBone = (uint)Idx[i];
			}
		}
	}

	// 0 on rigidly bound skin, 1 exactly on the 50/50 blend line that runs along the joint.
	const float JointBlend = saturate(4.0f * LargestWeight * SecondWeight);
	const float JointBand = pow(max(JointBlend, 0.0f), max(CreaseSharpness, 1.0f));

	// ---- bone axis, and the stretch along / across it ------------------------
	// RefInv maps rest component space into the bone's local frame (p' = M p), so the bone's local
	// +X expressed in component space is the first COLUMN of its rotation. MetaHuman / UE bones run
	// down local -X, but for a stretch along an axis the sign does not matter.
	const FBoneTransform RefInv = RefPoseInverses[min(DominantBone, NumSectionBones - 1)];
	const float3 BoneAxis3 = float3(RefInv.Row0.x, RefInv.Row1.x, RefInv.Row2.x);
	float2 Ax = float2(dot(BoneAxis3, RestT), dot(BoneAxis3, RestB));
	Ax = (dot(Ax, Ax) > 1e-4f) ? normalize(Ax) : float2(1.0f, 0.0f);
	const float2 Px = float2(-Ax.y, Ax.x);
	const float LambdaBone = sqrt(max(a * Ax.x * Ax.x + 2.0f * b * Ax.x * Ax.y + d * Ax.y * Ax.y, 0.0f));
	const float LambdaPerp = sqrt(max(a * Px.x * Px.x + 2.0f * b * Px.x * Px.y + d * Px.y * Px.y, 0.0f));

	// Compression and stretch are handled separately on purpose. Skin is not symmetric about rest:
	// the inside of a bend folds hard, while the outside only smooths - one signed term cannot do both.
	const float Stretch = max(LambdaMax - 1.0f, 0.0f);
	const float Compression = max(1.0f - LambdaBone, 0.0f);     // along the bone: what a bend does
	const float CompressAcross = max(1.0f - LambdaPerp, 0.0f);  // across it: sideways squash
	const float Slack = RelaxStateIn[VertexIndex].y;

	// ---- resting crease: deepened by compression, ironed flat by stretch -----
	// Clamped at zero so a hard stretch flattens the groove but never inverts it into a ridge.
	const float CreaseScale = max(
		1.0f + CreaseCompressionGain * Compression * 10.0f - CreaseStretchRelief * Stretch * 10.0f,
		0.0f);
	float CreaseTerm = -CreaseDepth * JointBand * CreaseScale
	                 - RelaxCreaseGain * JointBand * Slack;
	if (bHasWrinkleMask != 0u)
	{
		// the narrow groove replaces the band-wide trench; the relax term still rides on the band
		CreaseTerm = MaskCreaseDisplacement(Vc, saturate(Compression * TensionScale), saturate(Stretch * TensionScale))
		           - RelaxCreaseGain * JointBand * Slack
		           + DorsalGatherDisplacement(Vc, saturate(Stretch * TensionScale), DominantBone, SecondBone)
		           + PalmarFoldDisplacement(Vc, saturate(Compression * TensionScale), DominantBone, SecondBone);
	}

	// ---- ripples along the bone axis ----------------------------------------
	// Driven by along-bone compression while bending, and by the released slack on the way back out -
	// that second term is what puts folds on the back of a knuckle just after the finger straightens.
	const float3 RestP = (bUseProportionedRest != 0u) ? LoadPosition(ProportionedRestPositionBuffer, VertexIndex) : LoadPosition(RestPositionBuffer, VertexIndex);
	const float3 BoneLocal = TransformPosition(RefInv, RestP);
	const float RippleDrive = Compression + Slack;
	const float WrinkleTerm = WrinkleAmplitude * JointBand * RippleDrive * sin(WrinkleFrequency * BoneLocal.x);

	// ---- bone-relative strain to the material -------------------------------
	const float4 Color = float4(saturate(Stretch * TensionScale), saturate(Compression * TensionScale),
	                            saturate(CompressAcross * TensionScale), Slack);
	ColorBufferUAV[VertexIndex] = Color FMANUALFETCH_COLOR_COMPONENT_SWIZZLE;

	float Displacement = VolumeTerm + CreaseTerm + WrinkleTerm;
	float3 ContactPush = float3(0, 0, 0);
	if (bContactBulge != 0u && SecondWeight > 0.02f)
	{
		float Bulge;
		if (ContactBulge(SkinnedP, RestP, DominantBone, SecondBone, ContactPush, Bulge))
		{
			Displacement += Bulge;
		}
	}
	const float3 OutP = SkinnedP + Normal * Displacement + ContactPush;

	PositionBufferUAV[VertexIndex * 3 + 0] = OutP.x;
	PositionBufferUAV[VertexIndex * 3 + 1] = OutP.y;
	PositionBufferUAV[VertexIndex * 3 + 2] = OutP.z;
}

// ---------------------------------------------------------------------------
// Normal recomputation - accumulate (per triangle)
// ---------------------------------------------------------------------------

uint NumTriangles;
uint BaseIndex;

Buffer<uint>  IndexBuffer;
Buffer<float> DisplacedPositionBuffer;     // SRV view of the buffer DisplaceCS wrote

RWStructuredBuffer<int> NormalAccum;       // 3 ints per LOD vertex

void AccumulateNormal(uint VertexIndex, float3 FaceNormal)
{
	const int3 Packed = (int3)round(FaceNormal * NORMAL_FIXED_SCALE);
	InterlockedAdd(NormalAccum[VertexIndex * 3 + 0], Packed.x);
	InterlockedAdd(NormalAccum[VertexIndex * 3 + 1], Packed.y);
	InterlockedAdd(NormalAccum[VertexIndex * 3 + 2], Packed.z);
}

[numthreads(THREADGROUP_SIZE, 1, 1)]
void NormalAccumulateCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint Tri = DispatchThreadId.x;
	if (Tri >= NumTriangles)
	{
		return;
	}
	const uint I = BaseIndex + Tri * 3;
	const uint V0 = IndexBuffer[I + 0];
	const uint V1 = IndexBuffer[I + 1];
	const uint V2 = IndexBuffer[I + 2];

	const float3 P0 = LoadPosition(DisplacedPositionBuffer, V0);
	const float3 P1 = LoadPosition(DisplacedPositionBuffer, V1);
	const float3 P2 = LoadPosition(DisplacedPositionBuffer, V2);

	const float3 Face = cross(P2 - P0, P1 - P0);
	const float FaceLen = length(Face);
	if (FaceLen < 1e-12f)
	{
		return;
	}
	// Unit face normals: equal weighting keeps the fixed point accumulation bounded.
	const float3 FaceNormal = Face / FaceLen;

	AccumulateNormal(V0, FaceNormal);
	AccumulateNormal(V1, FaceNormal);
	AccumulateNormal(V2, FaceNormal);
}

// ---------------------------------------------------------------------------
// Normal recomputation - resolve (per LOD vertex)
// ---------------------------------------------------------------------------

uint NumLodVertices;

StructuredBuffer<int> NormalAccumIn;

[numthreads(THREADGROUP_SIZE, 1, 1)]
void NormalResolveCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint V = DispatchThreadId.x;
	if (V >= NumLodVertices)
	{
		return;
	}

	const uint Vc = WeldCanon[V];              // seam twins share one accumulated normal
	const float3 Sum = float3(
		(float)NormalAccumIn[Vc * 3 + 0],
		(float)NormalAccumIn[Vc * 3 + 1],
		(float)NormalAccumIn[Vc * 3 + 2]) / NORMAL_FIXED_SCALE;

	const float SumLen = length(Sum);
	if (SumLen < 1e-6f)
	{
		return;   // isolated / degenerate vertex: keep whatever skinning produced
	}
	const float3 NewNormal = Sum / SumLen;

	const float4 OldTX = TangentBias_SkinCache(TangentBufferUAV[V * 2 + GPUSKIN_RWBUFFER_OFFSET_TANGENT_X]);
	const float4 OldTZ = TangentBias_SkinCache(TangentBufferUAV[V * 2 + GPUSKIN_RWBUFFER_OFFSET_TANGENT_Z]);

	// Gram-Schmidt the existing tangent against the new normal so UV-space stays consistent.
	float3 NewTangent = OldTX.xyz - NewNormal * dot(NewNormal, OldTX.xyz);
	const float TangentLen = length(NewTangent);
	NewTangent = (TangentLen > 1e-6f) ? (NewTangent / TangentLen) : OldTX.xyz;

	TangentBufferUAV[V * 2 + GPUSKIN_RWBUFFER_OFFSET_TANGENT_X] = TangentUnbias_SkinCache(float4(NewTangent, OldTX.w));
	TangentBufferUAV[V * 2 + GPUSKIN_RWBUFFER_OFFSET_TANGENT_Z] = TangentUnbias_SkinCache(float4(NewNormal, OldTZ.w));
}
