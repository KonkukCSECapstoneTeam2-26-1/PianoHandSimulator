// PianoHand custom skinning - per-vertex strain TENSOR kernels (Phase 2, revised)
//
// Runs after CustomSkinningDeformer.usf inside the same RDG graph.
//
// The first version of this file averaged a scalar edge strain (|p_i-p_j|/|r_i-r_j| - 1) per vertex.
// A scalar cannot say in WHICH direction skin is compressed, and that direction is what decides
// where a wrinkle runs: folds form perpendicular to the compression axis (Rohmer et al. 2010,
// "Animation Wrinkling: Augmenting Coarse Cloth Simulations with Realistic-Looking Wrinkles").
// So this version follows that paper and computes, per triangle, the 2D deformation gradient
//
//     F = [p1 p2] * [u1 u2]^-1        (rest edges u_i in the triangle plane, skinned edges p_i)
//
// and its right Cauchy-Green tensor C = F^T F, whose eigenvalues are the squared principal
// stretches (lambda_1^2, lambda_2^2) and whose eigenvectors are the stretch / compression axes.
//
//  AccumulateCS : one thread per triangle. Builds C in the triangle's rest basis (e1, e2), lifts it
//                 to a 3x3 tensor in REST COMPONENT SPACE (C3 = sum_ij C_ij e_i e_j^T) and atomically
//                 adds its 6 unique components + a count onto the 3 vertices. Component space is used
//                 so that neighbouring triangles with different local bases can be averaged without
//                 any per-triangle rotation.
//  ResolveCS    : one thread per LOD vertex. Averages C3, projects it onto the vertex's rest tangent
//                 plane (T, B from the rest tangent buffer) and eigen-decomposes the 2x2 result.
//                 Writes the averaged C3 for CustomSkinningDetail.usf and the vertex colour:
//                   R = saturate((lambda_max - 1) * TensionScale)   stretch     (0..1)
//                   G = saturate((1 - lambda_min) * TensionScale)   compression (0..1)
//                   B = 0 here; DisplaceCS, which knows the bone axis, overwrites G/B with the
//                       compression ALONG and ACROSS the bone (see CustomSkinningDetail.usf)
//                   A = relax slack (0..1) - stretch that has just been released, decaying
//                 Materials read this through the VertexColor node.

#include "/Engine/Private/Common.ush"
#include "/Engine/Private/GpuSkinCommon.ush"

#ifndef THREADGROUP_SIZE
#define THREADGROUP_SIZE 64
#endif

// Fixed point scale for the atomic accumulation. Tensor components are clamped to [-64, 64]
// (lambda up to 8) before packing, so up to ~1000 incident triangles cannot overflow int32.
#define TENSOR_FIXED_SCALE 32768.0f
#define TENSOR_STRIDE 6u   // xx, yy, zz, xy, xz, yz
#define MAX_SKIN_TRIANGLE_AREA 0.05f   // cm^2; the dense hand's triangles are ~0.003, the wrist cap's ~0.3

// ---------------------------------------------------------------------------
// Accumulate (per triangle)
// ---------------------------------------------------------------------------

uint NumTriangles;         // triangles in this section
uint BaseIndex;            // first index of this section inside the LOD index buffer

Buffer<uint>  IndexBuffer;             // LOD index buffer (16 or 32 bit typed SRV, both read as uint)
Buffer<float> RestPositionBuffer;      // 3 floats per vertex (engine position vertex buffer)
Buffer<float> SkinnedPositionBuffer;   // 3 floats per vertex (output of DeformCS)
// Phase 5 (proportions): the rest pose skinned with the per-bone proportion scales. The strain is
// taken against THIS when bUseProportionedRest, so a finger made longer by the proportions is not
// read as stretched skin.
uint          bUseProportionedRest;
Buffer<float> ProportionedRestPositionBuffer;

RWStructuredBuffer<int>  TensorAccum;  // 6 fixed point tensor components per LOD vertex
RWStructuredBuffer<uint> TensorCount;  // number of triangle contributions per LOD vertex
// Sum of the rest face normals' outer products n n^T, 6 fixed point components per vertex.
// A rigid triangle contributes C3 = I - n n^T (the projector onto its plane). Averaged over a
// vertex's fan and projected onto the vertex's OWN tangent plane that is the identity only if all
// the faces share that plane; at a crease (the wrist cap ring, a nail edge) the projected area
// ratio drops by cos^2 of the normal tilt and the kernel reports compression that is not there -
// a fringe of volume-term spikes along the ring, at rest. Adding the averaged n n^T back
// (ResolveCS) makes a rigid vertex exactly the identity whatever its crease angle.
RWStructuredBuffer<int>  NormalOuterAccum;

float3 LoadPos(Buffer<float> Buf, uint VertexIndex)
{
	return float3(Buf[VertexIndex * 3 + 0], Buf[VertexIndex * 3 + 1], Buf[VertexIndex * 3 + 2]);
}

float3 LoadRestPos(uint VertexIndex)
{
	return (bUseProportionedRest != 0u) ? LoadPos(ProportionedRestPositionBuffer, VertexIndex) : LoadPos(RestPositionBuffer, VertexIndex);
}

void AccumulateTensor(uint V, float C[6])
{
	UNROLL
	for (uint i = 0; i < TENSOR_STRIDE; ++i)
	{
		InterlockedAdd(TensorAccum[V * TENSOR_STRIDE + i], (int)round(clamp(C[i], -64.0f, 64.0f) * TENSOR_FIXED_SCALE));
	}
	InterlockedAdd(TensorCount[V], 1u);
}

[numthreads(THREADGROUP_SIZE, 1, 1)]
void AccumulateCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint Tri = DispatchThreadId.x;
	if (Tri >= NumTriangles)
	{
		return;
	}
	const uint I = BaseIndex + Tri * 3;
	const uint V0 = IndexBuffer[I + 0];
	const uint V1 = IndexBuffer[I + 1];
	const uint V2 = IndexBuffer[I + 2];

	const float3 R0 = LoadRestPos(V0);
	const float3 R1 = LoadRestPos(V1);
	const float3 R2 = LoadRestPos(V2);
	const float3 P0 = LoadPos(SkinnedPositionBuffer, V0);
	const float3 P1 = LoadPos(SkinnedPositionBuffer, V1);
	const float3 P2 = LoadPos(SkinnedPositionBuffer, V2);

	// ---- rest triangle basis ------------------------------------------------
	const float3 U1 = R1 - R0;
	const float3 U2 = R2 - R0;
	float3 N = cross(U1, U2);
	const float NLen = length(N);
	const float U1Len = length(U1);
	// Degenerate rest triangle (duplicated vertices, zero area) contributes nothing. Neither does a
	// SLIVER: a plane cut or a UV seam leaves triangles a few microns tall whose deformation
	// gradient is ill-conditioned, and they show up as a fringe of spikes wherever the strain is
	// read. Altitude = 2 * area / longest edge, in cm.
	// Nor does a CAP triangle: the wrist is closed with a fan of ~0.3 cm^2 triangles, a hundred times
	// the size of a skin triangle. Their strain (the fan spokes pivot with the ring) is not skin
	// strain, and spread onto the ring vertices it displaced them into a fringe of spikes.
	const float LongestEdge = max(U1Len, max(length(U2), length(R2 - R1)));
	if (NLen < 1e-10f || U1Len < 1e-5f || NLen / max(LongestEdge, 1e-6f) < 0.012f || NLen > 2.0f * MAX_SKIN_TRIANGLE_AREA)
	{
		return;
	}
	N /= NLen;
	const float3 E1 = U1 / U1Len;
	const float3 E2 = cross(N, E1);

	// rest edges in 2D: u1 = (U1Len, 0), u2 = (u2.x, u2.y)
	const float2 u2 = float2(dot(U2, E1), dot(U2, E2));
	const float Det = U1Len * u2.y;          // det [u1 u2]
	if (abs(Det) < 1e-8f)
	{
		return;
	}

	// ---- deformation gradient F = [p1 p2] [u1 u2]^-1 (3x2, columns F1, F2) ----
	const float3 D1 = P1 - P0;
	const float3 D2 = P2 - P0;
	const float3 F1 = D1 * (u2.y / Det);
	const float3 F2 = (D2 * U1Len - D1 * u2.x) / Det;

	// ---- C = F^T F in the (E1, E2) basis ----
	const float A = dot(F1, F1);
	const float B = dot(F1, F2);
	const float D = dot(F2, F2);

	// ---- lift to rest component space: C3 = A e1e1' + B (e1e2' + e2e1') + D e2e2' ----
	float C[6];
	C[0] = A * E1.x * E1.x + 2.0f * B * E1.x * E2.x + D * E2.x * E2.x;                 // xx
	C[1] = A * E1.y * E1.y + 2.0f * B * E1.y * E2.y + D * E2.y * E2.y;                 // yy
	C[2] = A * E1.z * E1.z + 2.0f * B * E1.z * E2.z + D * E2.z * E2.z;                 // zz
	C[3] = A * E1.x * E1.y + B * (E1.x * E2.y + E2.x * E1.y) + D * E2.x * E2.y;        // xy
	C[4] = A * E1.x * E1.z + B * (E1.x * E2.z + E2.x * E1.z) + D * E2.x * E2.z;        // xz
	C[5] = A * E1.y * E1.z + B * (E1.y * E2.z + E2.y * E1.z) + D * E2.y * E2.z;        // yz

	AccumulateTensor(V0, C);
	AccumulateTensor(V1, C);
	AccumulateTensor(V2, C);

	float NN[6];
	NN[0] = N.x * N.x; NN[1] = N.y * N.y; NN[2] = N.z * N.z;
	NN[3] = N.x * N.y; NN[4] = N.x * N.z; NN[5] = N.y * N.z;
	UNROLL
	for (uint k = 0; k < TENSOR_STRIDE; ++k)
	{
		const int Packed = (int)round(NN[k] * TENSOR_FIXED_SCALE);
		InterlockedAdd(NormalOuterAccum[V0 * TENSOR_STRIDE + k], Packed);
		InterlockedAdd(NormalOuterAccum[V1 * TENSOR_STRIDE + k], Packed);
		InterlockedAdd(NormalOuterAccum[V2 * TENSOR_STRIDE + k], Packed);
	}
}

// ---------------------------------------------------------------------------
// Resolve (per vertex)
// ---------------------------------------------------------------------------

uint  NumVertices;         // vertices in the LOD
float TensionScale;        // strain -> 0..1 mapping (e.g. 4 => 25% stretch saturates)
float DeltaTime;           // seconds since the last dispatch, clamped on the CPU side
float RelaxGain;           // log-strain -> 0..1 slack colour gain
float RelaxTau;            // seconds, viscoelastic relaxation time constant (Montes Maestre 2026: 1/12 s)
uint  bResetRelax;         // 1 on the first frame / after a LOD change: start from a clean state

Buffer<SNORM float4>   RestTangentBuffer;   // 2 per vertex: TangentX, TangentZ (w = bitangent sign)
Buffer<SNORM float4>   ProportionedRestTangentBuffer;   // Phase 5: same, from the proportion-scaled rest skinning (bUseProportionedRest)
StructuredBuffer<int>  TensorAccumIn;
StructuredBuffer<uint> TensorCountIn;
StructuredBuffer<int>  NormalOuterAccumIn;  // see NormalOuterAccum above
StructuredBuffer<uint> WeldCanon;           // 10-18: canonical vertex of a UV-seam twin (the accumulations live there)
RWBuffer<UNORM float4> ColorBufferUAV;      // passthrough vertex factory colour buffer (RGBA8)
RWStructuredBuffer<float> VertexTensorOut;  // averaged C3, 6 floats per vertex, consumed by CustomSkinningDetail.usf
RWStructuredBuffer<float2> RelaxState;      // PERSISTS between frames: .x = last total log-strain, .y = viscous log-strain E_v

// v^T C3 w for a symmetric 3x3 stored as (xx, yy, zz, xy, xz, yz)
float TensorForm(float C[6], float3 V, float3 W)
{
	return C[0] * V.x * W.x + C[1] * V.y * W.y + C[2] * V.z * W.z
	     + C[3] * (V.x * W.y + V.y * W.x)
	     + C[4] * (V.x * W.z + V.z * W.x)
	     + C[5] * (V.y * W.z + V.z * W.y);
}

[numthreads(THREADGROUP_SIZE, 1, 1)]
void ResolveCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint V = DispatchThreadId.x;
	if (V >= NumVertices)
	{
		return;
	}
	const uint Vc = WeldCanon[V];              // seam twins share the canonical vertex's accumulation
	const uint Count = TensorCountIn[Vc];

	// Rest tangent frame of the vertex. The tensor is projected onto this plane, which is also the
	// material's tangent space, so anything derived here lines up with the normal map.
	const float4 TX = (bUseProportionedRest != 0u) ? ProportionedRestTangentBuffer[V * 2 + GPUSKIN_VB_OFFSET_TANGENT_X] : RestTangentBuffer[V * 2 + GPUSKIN_VB_OFFSET_TANGENT_X];
	const float4 TZ = (bUseProportionedRest != 0u) ? ProportionedRestTangentBuffer[V * 2 + GPUSKIN_VB_OFFSET_TANGENT_Z] : RestTangentBuffer[V * 2 + GPUSKIN_VB_OFFSET_TANGENT_Z];
	const float3 N = normalize(TZ.xyz + float3(0, 0, 1e-6f));
	float3 T = TX.xyz - N * dot(N, TX.xyz);
	T = (dot(T, T) > 1e-8f) ? normalize(T) : float3(1, 0, 0);
	const float3 Bt = cross(N, T) * (TZ.w < 0.0f ? -1.0f : 1.0f);

	float C[6];
	if (Count > 0u)
	{
		UNROLL
		for (uint i = 0; i < TENSOR_STRIDE; ++i)
		{
			C[i] = ((float)TensorAccumIn[Vc * TENSOR_STRIDE + i] / TENSOR_FIXED_SCALE) / (float)Count
			     + ((float)NormalOuterAccumIn[Vc * TENSOR_STRIDE + i] / TENSOR_FIXED_SCALE) / (float)Count;
		}
	}
	else
	{
		// isolated vertex: identity in the tangent plane
		C[0] = T.x * T.x + Bt.x * Bt.x; C[1] = T.y * T.y + Bt.y * Bt.y; C[2] = T.z * T.z + Bt.z * Bt.z;
		C[3] = T.x * T.y + Bt.x * Bt.y; C[4] = T.x * T.z + Bt.x * Bt.z; C[5] = T.y * T.z + Bt.y * Bt.z;
	}
	UNROLL
	for (uint j = 0; j < TENSOR_STRIDE; ++j)
	{
		VertexTensorOut[V * TENSOR_STRIDE + j] = C[j];
	}

	// ---- 2x2 in the tangent plane, eigenvalues = squared principal stretches ----
	const float a = TensorForm(C, T, T);
	const float b = TensorForm(C, T, Bt);
	const float d = TensorForm(C, Bt, Bt);
	const float Half = 0.5f * (a + d);
	const float Disc = sqrt(max(0.25f * (a - d) * (a - d) + b * b, 0.0f));
	const float LambdaMax = sqrt(max(Half + Disc, 0.0f));
	const float LambdaMin = sqrt(max(Half - Disc, 0.0f));
	const float Stretch = max(LambdaMax - 1.0f, 0.0f);
	const float Compress = max(1.0f - LambdaMin, 0.0f);

	// ---------------------------------------------------------------------------
	// Viscoelastic strain memory - the only history this pipeline keeps
	//
	// Strain alone is memoryless: a finger held straight looks identical whether it has been straight
	// all along or has just come back from a hard bend. Real skin is viscoelastic. Following Montes
	// Maestre et al. 2026 ("Physics-Based Simulation of Contact-Induced Facial Wrinkling", SCA), the
	// log-strain is split into an elastic part and a viscous (damper) part, E = E_e + E_v, and the
	// damper relaxes towards the total strain with time constant tau:
	//     E_v <- E_v + (1 - alpha) (E - E_v),   alpha = exp(-dt / tau)
	// so the elastic part E_e = E - E_v is what the skin "feels" right now. Hold a stretch and E_v
	// catches up with it, E_e decays, the skin accommodates. Release it and E drops to zero while E_v
	// is still positive: E_e goes NEGATIVE - a transient compression - which is exactly the slack that
	// gathers into folds on the back of a knuckle just after the finger straightens, and it then
	// decays with the same tau. One law, both directions, instead of the ad-hoc "released stretch"
	// counter this used to be. The paper's tau is 1/12 s for a face; RelaxTau is that knob.
	// E here is the signed AREA log-strain in the tangent plane, log(lambda_1) + log(lambda_2):
	// positive when the skin is pulled taut, negative when it is gathered.
	// ---------------------------------------------------------------------------
	const float E_total = log(max(LambdaMax, 1e-3f)) + log(max(LambdaMin, 1e-3f));
	const float2 PrevState = (bResetRelax != 0u) ? float2(E_total, E_total) : RelaxState[V];
	const float Alpha = exp(-DeltaTime / max(RelaxTau, 1e-3f));
	const float E_v = PrevState.y + (1.0f - Alpha) * (E_total - PrevState.y);
	const float E_e = E_total - E_v;
	// the material reads "slack" = transient compression beyond what the skin has accommodated,
	// RelaxGain maps log-strain to the 0..1 colour range (6 => 17% transient compression saturates)
	const float Slack = saturate(-E_e * RelaxGain);

	RelaxState[V] = float2(E_total, E_v);

	// A carries the slack to the material - the colour buffer's alpha was a constant 1 before.
	const float4 Color = float4(saturate(Stretch * TensionScale), saturate(Compress * TensionScale), 0.0f, Slack);
	// Same swizzle the engine's own deformer writer uses so the vertex factory reads RGBA back correctly.
	ColorBufferUAV[V] = Color FMANUALFETCH_COLOR_COMPONENT_SWIZZLE;
}


// ---------------------------------------------------------------------------
// Tensor smoothing (Phase 7b) - 1-ring Laplacian on the averaged tensor
//
// The per-vertex tensor is the mean over the incident triangles only. In a fist, where the LBS
// mesh folds onto itself and triangles collapse, that mean swings from vertex to vertex and every
// consumer - the volume bulge, the crease gates, the fold ripples - turns into cobblestones. Two
// passes of Laplacian smoothing (scatter each vertex's tensor to its triangle neighbours, then blend
// the neighbour mean back in) leave the field physically the same at the scale of a joint and take
// the vertex-to-vertex noise out. Same fixed-point atomics as AccumulateCS.
// ---------------------------------------------------------------------------

StructuredBuffer<float> SmoothTensorIn;          // 6 floats per LOD vertex (VertexTensorOut of the previous step)
RWStructuredBuffer<float> SmoothTensorOut;
float SmoothLambda;                              // 0..1 blend towards the neighbour mean

[numthreads(THREADGROUP_SIZE, 1, 1)]
void SmoothScatterCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint Tri = DispatchThreadId.x;
	if (Tri >= NumTriangles)
	{
		return;
	}
	const uint I = BaseIndex + Tri * 3;
	const uint V[3] = { IndexBuffer[I + 0], IndexBuffer[I + 1], IndexBuffer[I + 2] };
	UNROLL
	for (uint a = 0; a < 3; ++a)
	{
		UNROLL
		for (uint b = 0; b < 3; ++b)
		{
			if (a == b) continue;
			UNROLL
			for (uint c = 0; c < TENSOR_STRIDE; ++c)
			{
				const float X = clamp(SmoothTensorIn[V[b] * TENSOR_STRIDE + c], -64.0f, 64.0f);
				InterlockedAdd(TensorAccum[V[a] * TENSOR_STRIDE + c], (int)round(X * TENSOR_FIXED_SCALE));
			}
			InterlockedAdd(TensorCount[V[a]], 1u);
		}
	}
}

[numthreads(THREADGROUP_SIZE, 1, 1)]
void SmoothResolveCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint V = DispatchThreadId.x;
	if (V >= NumVertices)
	{
		return;
	}
	const uint Vc = WeldCanon[V];
	const uint Count = TensorCountIn[Vc];
	UNROLL
	for (uint c = 0; c < TENSOR_STRIDE; ++c)
	{
		const float Own = SmoothTensorIn[V * TENSOR_STRIDE + c];
		const float Mean = (Count > 0u) ? ((float)TensorAccumIn[Vc * TENSOR_STRIDE + c] / TENSOR_FIXED_SCALE) / (float)Count : Own;
		SmoothTensorOut[V * TENSOR_STRIDE + c] = lerp(Own, Mean, SmoothLambda);
	}
}
