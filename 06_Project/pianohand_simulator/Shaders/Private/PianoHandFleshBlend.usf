// Chaos Flesh -> PianoHand skinning adapter (04_Flesh).
//
// Runs right after the skinning pass (DeformCS) and before implicit skinning: mixes the skinned vertex position
// with the position Chaos Flesh computed for the same render vertex.
//   Out = lerp(Skinned, Flesh, BlendWeight)
// Both are in the skinned mesh component's local space. BlendWeight 0 leaves the skinned result untouched.

#include "/Engine/Public/Platform.ush"

uint NumVertices;
float BlendWeight;
StructuredBuffer<float3> FleshPositions;
RWBuffer<float> PositionBufferUAV;

[numthreads(THREADGROUP_SIZE, 1, 1)]
void BlendCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint VertexIndex = DispatchThreadId.x;
	if (VertexIndex >= NumVertices)
	{
		return;
	}

	const float3 Skinned = float3(
		PositionBufferUAV[VertexIndex * 3 + 0],
		PositionBufferUAV[VertexIndex * 3 + 1],
		PositionBufferUAV[VertexIndex * 3 + 2]);
	const float3 Flesh = FleshPositions[VertexIndex];
	const float3 OutP = lerp(Skinned, Flesh, BlendWeight);

	PositionBufferUAV[VertexIndex * 3 + 0] = OutP.x;
	PositionBufferUAV[VertexIndex * 3 + 1] = OutP.y;
	PositionBufferUAV[VertexIndex * 3 + 2] = OutP.z;
}
